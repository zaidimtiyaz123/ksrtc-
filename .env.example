# ==============================================================================
# KSRTC SMARTTRACK ENVIRONMENT VARIABLES & API KEYS
# ==============================================================================
# Configure these API keys in the Google AI Studio Settings menu.
# All secret keys are held server-side to prevent exposure to the browser.
# ==============================================================================

# 1. Google Gemini AI API Key (Server-Side)
# Powers the KSRTC SmartTrack AI Transit Copilot, intelligent multi-lingual voice
# announcements (Kannada, English, Hindi), and central dispatch recommendations.
GEMINI_API_KEY=

# 2. Supabase PostgreSQL & Real-Time Telemetry Credentials
# Connects to Supabase PostgreSQL database for persistent driver GPS telemetry,
# bus tracking logs, and background synchronization at 4-second intervals.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Client-Side Supabase (prefixed with VITE_ for browser subscriptions)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 3. IVR Telephony & SMS Gateway (Exotel / Twilio / Universal Provider)
# Powers automated telephone hotline, DTMF stop-code inquiry, and SMS tracking links.
IVR_PROVIDER="exotel"
IVR_API_KEY=
IVR_API_SECRET=
IVR_PHONE_NUMBER="+918022221234"

# Optional: Twilio Provider Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 4. Google Maps Platform API Key
# For Google Maps JavaScript SDK, vector map tiles, AdvancedMarkers, and real-time transit routing.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# 5. App Hosting URL
APP_URL=
